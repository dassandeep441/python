<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>VectorIQ - AI-Powered Trading Intelligence</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    /* ===== CSS Variables ===== */
    :root {
      --primary: #2E86C1;
      --primary-dark: #1E5A8A;
      --secondary: #28B463;
      --alert: #E74C3C;
      --background: #1A1A1A;
      --background-light: #2A2A2A;
      --text: #ECF0F1;
      --text-secondary: #BDC3C7;
      --border: #34495E;
      --success: #27AE60;
      --warning: #F39C12;
      --card-bg: #2A2A2A;
      --chart-bg: #1A1A1A;
      --shadow: rgba(0, 0, 0, 0.2);
    }

    /* Light Mode Variables */
    [data-theme="light"] {
      --background: #F5F7FA;
      --background-light: #FFFFFF;
      --text: #2C3E50;
      --text-secondary: #7F8C8D;
      --border: #E0E0E0;
      --card-bg: #FFFFFF;
      --chart-bg: #FFFFFF;
      --shadow: rgba(0, 0, 0, 0.1);
    }

    /* ===== Reset & Base Styles ===== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--background);
      color: var(--text);
      line-height: 1.6;
      transition: background-color 0.3s, color 0.3s;
      overflow-x: hidden;
    }

    /* ===== Mobile-First Layout ===== */
    .container {
      display: grid;
      grid-template-rows: auto 1fr;
      min-height: 100vh;
      overflow: hidden;
    }

    /* ===== Header ===== */
    header {
      background-color: var(--background-light);
      padding: 10px 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .logo {
      font-size: 1.3rem;
      font-weight: bold;
      color: var(--primary);
    }

    .logo span {
      color: var(--text);
    }

    .menu-toggle {
      background: none;
      border: none;
      color: var(--text);
      font-size: 1.5rem;
      cursor: pointer;
      display: none;
    }

    .theme-toggle {
      background: none;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      font-size: 1.2rem;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background-color: var(--primary);
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      font-weight: bold;
      font-size: 0.9rem;
    }

    /* ===== Sidebar (Mobile) ===== */
    .sidebar {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 70%;
      max-width: 250px;
      height: 100vh;
      background-color: var(--background-light);
      padding: 20px;
      border-right: 1px solid var(--border);
      z-index: 200;
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
    }

    .sidebar.active {
      transform: translateX(0);
    }

    .sidebar-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 150;
    }

    .sidebar-overlay.active {
      display: block;
    }

    .sidebar-menu {
      list-style: none;
    }

    .sidebar-menu li {
      margin-bottom: 10px;
    }

    .sidebar-menu a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px;
      color: var(--text-secondary);
      text-decoration: none;
      border-radius: 5px;
      transition: all 0.3s;
    }

    .sidebar-menu a:hover, .sidebar-menu a.active {
      background-color: var(--primary-dark);
      color: var(--text);
    }

    .sidebar-menu i {
      width: 20px;
      text-align: center;
    }

    /* ===== Main Content ===== */
    main {
      padding: 15px;
      overflow-y: auto;
      background-color: var(--background);
    }

    /* ===== Trading Mode Toggle ===== */
    .trading-mode-toggle {
      display: flex;
      gap: 10px;
      margin-bottom: 15px;
      flex-wrap: wrap;
    }

    .mode-btn {
      padding: 6px 12px;
      border: none;
      border-radius: 5px;
      background-color: var(--background-light);
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.3s;
      font-size: 0.9rem;
    }

    .mode-btn.active {
      background-color: var(--primary);
      color: white;
    }

    /* ===== Dashboard Grid ===== */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 15px;
    }

    /* ===== Cards ===== */
    .card {
      background-color: var(--card-bg);
      border-radius: 8px;
      padding: 15px;
      border: 1px solid var(--border);
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 2px 4px var(--shadow);
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 8px var(--shadow);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .card-title {
      font-size: 1.1rem;
      font-weight: bold;
    }

    .card-actions {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    /* ===== Tables ===== */
    .scanner-results, .journal-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .scanner-results th, .scanner-results td,
    .journal-table th, .journal-table td {
      padding: 8px;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    .scanner-results th, .journal-table th {
      background-color: var(--primary-dark);
      color: var(--text);
    }

    .scanner-results tr:hover, .journal-table tr:hover {
      background-color: rgba(46, 134, 193, 0.1);
    }

    .signal-bullish {
      color: var(--success);
    }

    .signal-bearish {
      color: var(--alert);
    }

    .profit {
      color: var(--success);
    }

    .loss {
      color: var(--alert);
    }

    /* ===== AI Panel ===== */
    .ai-panel {
      background-color: var(--card-bg);
      border-radius: 8px;
      padding: 15px;
      margin-top: 15px;
      border: 1px solid var(--border);
    }

    .ai-input {
      width: 100%;
      padding: 10px;
      border-radius: 5px;
      border: 1px solid var(--border);
      background-color: var(--background);
      color: var(--text);
      margin-bottom: 10px;
      font-size: 0.9rem;
    }

    .ai-response {
      background-color: rgba(46, 134, 193, 0.1);
      padding: 12px;
      border-radius: 5px;
      margin-top: 10px;
      border-left: 3px solid var(--primary);
      font-size: 0.9rem;
    }

    /* ===== Chart ===== */
    .chart-container {
      height: 250px;
      background-color: var(--chart-bg);
      border-radius: 8px;
      padding: 10px;
      margin-top: 10px;
      border: 1px solid var(--border);
    }

    /* ===== News Feed ===== */
    .news-feed {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .news-item {
      padding: 12px;
      border-bottom: 1px solid var(--border);
    }

    .news-item:last-child {
      border-bottom: none;
    }

    .news-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .news-title {
      font-weight: bold;
      font-size: 0.95rem;
      margin-bottom: 5px;
    }

    .news-meta {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 5px;
    }

    .news-source {
      font-size: 0.75rem;
      color: var(--text-secondary);
    }

    /* ===== Alerts ===== */
    .alerts-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .alert {
      padding: 10px;
      border-radius: 5px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: transform 0.2s;
      font-size: 0.9rem;
    }

    .alert:hover {
      transform: scale(1.01);
    }

    .alert.unread {
      border-left: 3px solid var(--primary);
    }

    .alert-icon {
      margin-right: 8px;
    }

    .alert-time {
      font-size: 0.75rem;
      color: var(--text-secondary);
    }

    .alert-close {
      background: none;
      border: none;
      color: var(--text-secondary);
      cursor: pointer;
      padding: 0 5px;
    }

    /* ===== Backtesting ===== */
    .backtest-form {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-bottom: 15px;
    }

    .backtest-results {
      margin-top: 15px;
    }

    .backtest-chart {
      height: 200px;
      background-color: var(--chart-bg);
      border-radius: 8px;
      padding: 10px;
      margin-top: 10px;
      border: 1px solid var(--border);
    }

    /* ===== Buttons ===== */
    .btn {
      padding: 6px 12px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.3s;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .btn-primary {
      background-color: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background-color: var(--primary-dark);
    }

    .btn-secondary {
      background-color: var(--background-light);
      color: var(--text);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      background-color: var(--border);
    }

    .btn-success {
      background-color: var(--success);
      color: white;
    }

    .btn-danger {
      background-color: var(--alert);
      color: white;
    }

    .btn-warning {
      background-color: var(--warning);
      color: white;
    }

    .btn-sm {
      padding: 4px 8px;
      font-size: 0.8rem;
    }

    /* ===== Forms ===== */
    .form-group {
      margin-bottom: 10px;
    }

    .form-label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
      font-size: 0.9rem;
    }

    .form-input, .form-select {
      width: 100%;
      padding: 8px;
      border-radius: 5px;
      border: 1px solid var(--border);
      background-color: var(--background);
      color: var(--text);
      font-size: 0.9rem;
    }

    .form-select {
      background-color: var(--background);
    }

    /* ===== Login Page ===== */
    .login-container {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      background-color: var(--background);
    }

    .login-card {
      background-color: var(--card-bg);
      padding: 25px;
      border-radius: 10px;
      width: 100%;
      max-width: 400px;
      border: 1px solid var(--border);
      text-align: center;
    }

    .login-title {
      margin-bottom: 15px;
      color: var(--primary);
      font-size: 1.5rem;
    }

    /* ===== Profile Page ===== */
    .profile-card {
      max-width: 100%;
    }

    .profile-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 15px;
      flex-wrap: wrap;
    }

    .profile-avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background-color: var(--primary);
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .profile-details {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 15px;
    }

    .profile-field {
      margin-bottom: 8px;
    }

    .profile-field-label {
      font-weight: bold;
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .profile-field-value {
      font-size: 0.95rem;
    }

    /* ===== Drag and Drop Dashboard ===== */
    .card.draggable {
      cursor: move;
      touch-action: none;
    }

    .card.dragging {
      opacity: 0.5;
    }

    .placeholder {
      background-color: rgba(46, 134, 193, 0.2);
      border: 2px dashed var(--primary);
      border-radius: 8px;
      min-height: 80px;
      display: none;
    }

    /* ===== Utility Classes ===== */
    .text-center {
      text-align: center;
    }

    .mt-5 { margin-top: 5px; }
    .mt-10 { margin-top: 10px; }
    .mt-15 { margin-top: 15px; }
    .mt-20 { margin-top: 20px; }
    .mb-5 { margin-bottom: 5px; }
    .mb-10 { margin-bottom: 10px; }
    .mb-15 { margin-bottom: 15px; }
    .mb-20 { margin-bottom: 20px; }
    .hidden { display: none !important; }

    /* ===== Responsive Adjustments ===== */
    @media (min-width: 600px) {
      .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .profile-details {
        grid-template-columns: repeat(2, 1fr);
      }

      .backtest-form {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 900px) {
      .container {
        grid-template-columns: 250px 1fr;
      }

      .sidebar {
        display: block;
        position: relative;
        transform: none;
        height: auto;
      }

      .sidebar-overlay {
        display: none;
      }

      .menu-toggle {
        display: none;
      }

      .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .chart-container {
        height: 280px;
      }

      .backtest-chart {
        height: 220px;
      }

      .user-avatar {
        width: 40px;
        height: 40px;
        font-size: 1rem;
      }

      .logo {
        font-size: 1.5rem;
      }
    }

    @media (min-width: 1200px) {
      .dashboard-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .chart-container {
        grid-column: span 2;
        height: 300px;
      }

      .backtest-chart {
        height: 250px;
      }
    }

    /* ===== Scrollbar Styling ===== */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-track {
      background: var(--background-light);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: var(--primary-dark);
    }
  </style>
</head>
